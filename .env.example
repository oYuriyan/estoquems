# ==========================================
# Configurações do Banco de Dados (PostgreSQL)
# ==========================================
POSTGRES_USER=estoque_user
POSTGRES_PASSWORD=sua_senha_super_segura_aqui
POSTGRES_DB=estoque_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ==========================================
# Configurações da API (Segurança)
# ==========================================
# Gere uma chave forte para produção: `openssl rand -hex 32`
JWT_SECRET_KEY=sua_chave_secreta_jwt_gerada_aqui

# Origem permitida para o Frontend
# Em produção interna, pode ser o IP da máquina, ex: http://192.168.1.100 ou https://192.168.1.100
FRONTEND_ORIGIN=http://seu_ip_interno_ou_dominio
