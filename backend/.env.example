# ──────────────────────────────────────────────────────────────
# Variáveis de ambiente do backend — NÃO versionar o .env real
# Copie este arquivo para .env e preencha os valores
# ──────────────────────────────────────────────────────────────

# ── Banco de Dados ──────────────────────────────────────────────
# URL de conexão async com o PostgreSQL
DATABASE_URL=postgresql+asyncpg://estoque_user:TROQUE_A_SENHA@postgres:5432/estoque_db

# ── JWT ─────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=TROQUE_PARA_UM_SEGREDO_FORTE_DE_64_CHARS
JWT_ALGORITHM=HS256
# Tempo de expiração do access token (em minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS / Origem do Frontend ──────────────────────────────────
# Domínio/porta onde o frontend está rodando
FRONTEND_ORIGIN=http://localhost:3030

# ── App ────────────────────────────────────────────────────────
APP_ENV=production
