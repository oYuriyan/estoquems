          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({input:[{id:$json.idGlpi,states_id:$json.target_state,comment:$json.target_comment}]}) }}"
      },
