    {
      "parameters": {
        "jsCode": "// 1. Pega todos os equipamentos que passaram pelo seu tratamento\nconst todosOsAtivos = $input.all().map(item => item.json);\n\n// 2. Converte o array inteiro para uma string JSON estruturada\nconst jsonString = JSON.stringify(todosOsAtivos, null, 2);\n\n// 3. Converte a string de texto para um buffer na memória\nconst buffer = Buffer.from(jsonString, 'utf-8');\n\n// 4. Utiliza o helper nativo do n8n para empacotar o arquivo binário\nconst binaryData = await this.helpers.prepareBinaryData(buffer, 'catalogo.json', 'application/json');\n\n// 5. Retorna um único item empacotado sob a chave 'data'\nreturn [{\n    json: { \n        mensagem: \"Catálogo unificado e convertido para binário com sucesso\",\n        totalAtivos: todosOsAtivos.length\n    },\n    binary: {\n        data: binaryData\n    }\n}];"
      },
