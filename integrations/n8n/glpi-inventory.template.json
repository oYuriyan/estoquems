    {
      "parameters": {
        "jsCode": "const legacyIdentityMap=__GLPI_LEGACY_IDENTITIES__;\n\nconst pages=$input.all().map(item=>item.json),rows=[];\nfor(const page of pages){if(!Array.isArray(page.data))throw new Error('Inventario GLPI invalido');rows.push(...page.data);}\nconst total=Number(pages[0]?.totalcount);\nif(!rows.length||!Number.isFinite(total)||rows.length!==total)throw new Error('Inventario vazio ou incompleto; arquivo anterior preservado');\nconst clean=v=>Array.isArray(v)?v.map(x=>String(x??'').trim()).join(' + '):String(v??'').trim();\nconst estoque=rows.map(item=>({\n // Preserve existing UUID-based identities until a separately reviewed migration.\n idPatrimonio:legacyIdentityMap[clean(item['2'])]||clean(item['47'])||'N/A',patrimonioGlpi:clean(item['6'])||clean(item['47']),\n idGlpi:clean(item['2']),numeroSerie:clean(item['5'])||clean(item['1']),tipo:clean(item['4']),marca:clean(item['23']),modelo:clean(item['40']),status:clean(item['31']),\n especificacoes:{processador:clean(item['17'])||'N/A',ram:clean(item['110'])||'N/A',armazenamento:clean(item['114'])||'N/A',so:clean(item['45'])||'N/A'}\n}));\nif(new Set(estoque.map(item=>item.idGlpi)).size!==estoque.length)throw new Error('Inventario GLPI duplicado; arquivo anterior preservado');\nreturn [{json:{metadados:{ultimaAtualizacao:new Date().toISOString(),totalItens:estoque.length},estoque}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
