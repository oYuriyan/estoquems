    {
      "id": "949084d8-51d3-4a13-a6a9-2ca46bf95fcd",
      "name": "Resultado por item",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst decision=$('Decidir').item.json,remote=$input.item.json;\nconst confirmed=decision.outcome==='eligible' && Number(remote.id)===decision.idGlpi && Number(remote.states_id)===decision.target_state && String(remote.comment||'')===decision.target_comment;\nreturn {json:{idGlpi:decision.idGlpi,numeroSerie:decision.numeroSerie,operationId:decision.operationId,action:decision.action,status:confirmed?'confirmed':decision.outcome==='conflict'?'conflict':'pending',changed:confirmed&&decision.should_write,original_state:decision.original_state,target_state:decision.target_state,message:confirmed?'Estado conferido no GLPI':decision.message}};\n"
      }
    },
    {
      "id": "2e88b39e-23d6-4a78-b64d-cee1d602888f",
      "name": "Resumo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst results=$input.all().map(item=>item.json),success=results.length>0&&results.every(item=>item.status==='confirmed');\nconst out={sucesso:success,operationId:($('Validar').first().json.operationId||$('Validar').first().json.propostaId),results,partial:!success&&results.some(item=>item.status==='confirmed')};\nif(results.some(item=>item.status==='conflict'))out.erro='Um ou mais equipamentos apresentam conflito';\nreturn [{json:out}];\n"
      }
    },
