    },
    {
      "id": "988c2c4e-eb86-427c-b44f-08fa0d1e8ce1",
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst session=$input.first().json.session_token;\nif(typeof session!=='string'||!session)throw new Error('Sessao GLPI nao confirmada');\nconst body=$('Validar').first().json;\nreturn body.itens.map(item=>({json:{idGlpi:Number(item.idGlpi),numeroSerie:item.numeroSerie||null,quoteId:body.propostaId,operationId:body.operationId||body.propostaId},pairedItem:{item:0}}));\n"
      }
    },
    {
      "id": "c5b95231-9391-4fc0-96b0-bb92ddefdcd4",
      "name": "Consultar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=__GLPI_API_BASE__/Computer/{{ $json.idGlpi }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "App-Token",
              "value": "__GLPI_APP_TOKEN__"
            },
            {
              "name": "Session-Token",
              "value": "={{ $('Sessao GLPI').first().json.session_token }}"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "ee40adcd-afcc-42be-8340-8d0db33f3de5",
      "name": "Decidir",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst item=$('Preparar').item.json,remote=$input.item.json;\nconst result={...item,action:\"cancel\",should_write:false,outcome:'pending',message:'Nao foi possivel consultar o equipamento'};\nif(Number(remote.id)!==item.idGlpi)return {json:result};\nif(item.numeroSerie && String(remote.serial||'').trim()!==String(item.numeroSerie).trim())return {json:{...result,outcome:'conflict',message:'Serial difere do equipamento solicitado'}};\nconst state=Number(remote.states_id),comment=String(remote.comment||'');\nconst match=comment.match(/\\n\\[LUMMIUM_RESERVA (\\{[^\\r\\n]*\\})\\]$/);\nlet marker=null;try{if(match)marker=JSON.parse(match[1]);}catch{}\nresult.original_state=state;\nif(\"cancel\"==='reserve'){\n if(state===17 && marker?.quote===item.quoteId)return {json:{...result,outcome:'eligible',target_state:17,target_comment:comment,message:'Reserva ja confirmada'}};\n if(![3,8].includes(state)||marker)return {json:{...result,outcome:'conflict',message:'Equipamento indisponivel ou reservado por outra proposta'}};\n return {json:{...result,outcome:'eligible',should_write:true,target_state:17,target_comment:comment+'\\n[LUMMIUM_RESERVA '+JSON.stringify({quote:item.quoteId,original_state:state})+']',message:'Reserva solicitada'}};\n}\nif([3,8].includes(state)&&!marker)return {json:{...result,outcome:'eligible',target_state:state,target_comment:comment,message:'Equipamento ja liberado'}};\nif(state!==17||marker?.quote!==item.quoteId||![3,8].includes(Number(marker.original_state)))return {json:{...result,outcome:'conflict',message:'Reserva nao pertence a esta proposta ou estado original desconhecido'}};\nreturn {json:{...result,outcome:'eligible',should_write:true,target_state:Number(marker.original_state),target_comment:comment.slice(0,match.index),message:'Cancelamento solicitado'}};\n"
      }
    },
    {
