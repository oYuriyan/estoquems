# ──────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente do Frontend para PRODUÇÃO
# O DSN do Sentry é público por design — pode ser versionado com segurança.
# Referência: https://docs.sentry.io/concepts/key-terms/dsn-explainer/
# ──────────────────────────────────────────────────────────────────────────

# ── Sentry — Error Tracking & Performance ─────────────────────────────────
VITE_SENTRY_DSN=https://2da99fbc84f88d615ed55077c06d1513@o4511552440107008.ingest.us.sentry.io/4511552579239936

# ── Versão (injetada automaticamente pelo CI via git SHA) ─────────────────
# Em produção manual, atualize para a versão da release:
VITE_APP_VERSION=1.0.0

# ── Upload de Source Maps para o Sentry (opcional, melhora stack traces) ──
# Gere em: https://sentry.io/settings/<org>/developer-settings/
# Só necessário se quiser que o Sentry mostre o TypeScript original nos erros
# SENTRY_AUTH_TOKEN=sntrys_xxxx
# SENTRY_ORG=seu-org-slug
# SENTRY_PROJECT=estoque-frontend
